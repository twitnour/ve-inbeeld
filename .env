# Public business-info values displayed on the site (phone, email,
# LinkedIn, KvK). None of these are secret — they're shown on the live
# site regardless — so, unlike backend/config.php, this file IS
# committed to git and safe to edit directly.
#
# IMPORTANT: this is a static frontend build with no server-side
# rendering. Editing a value here only takes effect after running
# `npm run build` and redeploying the resulting dist/ — it does NOT
# update the live site instantly the way backend/config.php does for
# the PHP backend (see backend/README.md).
#
# Read via src/lib/businessInfo.ts — don't read import.meta.env
# directly elsewhere.
#
# If you change the email address below, also update CONTACT_TO_EMAIL /
# CONTACT_FROM_EMAIL in backend/config.php by hand — the two systems
# aren't linked (see backend/config.example.php).

# Displayed email address, split into two parts on purpose (anti-scraping —
# see src/lib/businessInfo.ts). The two values below just spell out
# "user@domain" as normal — edit them the same way you'd edit one address,
# there's nothing to encode by hand.
VITE_CONTACT_EMAIL_USER="info"
VITE_CONTACT_EMAIL_DOMAIN="veinbeeld.nl"

# Phone number, written exactly as it should be displayed (spacing
# included) — the clickable tel: link is derived from this
# automatically, so there's only one value to keep up to date.
VITE_PHONE_NUMBER="+31 6 00 00 00 00"

# Full LinkedIn profile/company page URL (opens in a new tab).
VITE_LINKEDIN_URL="https://www.linkedin.com/in/marsha-lispet-75b971162/"

# KvK (Chamber of Commerce) registration number.
VITE_KVK_NUMBER="42155955"
